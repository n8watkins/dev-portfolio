{
  "name": "dev-portfolio",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --port 4829",
    "build": "next build",
    "start": "next start",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "check:deploy": "wrangler deploy --dry-run",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false cloudflare-env.d.ts",
    "check:cf-types": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false --check cloudflare-env.d.ts",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next && rm -rf out",
    "test": "playwright test",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'tests/unit/*.test.mts'",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:report": "playwright show-report",
    "analyze": "next analyze",
    "prepare": "husky",
    "check:sync": "node scripts/check-n8builds-sync.mjs",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run type-check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/cloudflare": "^11.10.0",
    "@sentry/nextjs": "^11.10.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-scroll": "^1.9.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-animated": "^2.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-lottie": "^1.2.10",
    "@types/react-scroll": "^1.8.10",
    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8",
    "release-kit": "github:n8watkins/release-kit#v2.9.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "wrangler": "4.157.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "minimatch": "^11.0.3",
    "glob": "^14.0.3"
  }
}
