{
  "name": "dev-portfolio",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "next dev --port 4829",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf .next && rm -rf out",
    "test": "playwright test",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test 'tests/unit/*.test.mts'",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:report": "playwright show-report",
    "analyze": "ANALYZE=true npm run build",
    "prepare": "husky",
    "check:sync": "node scripts/check-n8builds-sync.mjs",
    "release": "release-kit release",
    "release:check": "release-kit check && npm run lint && npm run type-check && npm run test:unit && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@sentry/nextjs": "^10.76.2",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "gsap": "^3.12.5",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.18.0",
    "mini-svg-data-uri": "^1.4.4",
    "motion": "^14.7.1",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.2.1",
    "react-scroll": "^1.9.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-animated": "^2.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@next/bundle-analyzer": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-lottie": "^1.2.10",
    "@types/react-scroll": "^1.8.10",
    "dotenv": "^17.2.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "postcss": "^8",
    "release-kit": "github:n8watkins/release-kit#v2.0.0",
    "svgo": "^4.1.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
